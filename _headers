# Cloudflare Pages _headers — applied to all matching responses
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Long-cache static assets (hashed/versioned by path)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: always revalidate so new articles/price changes show immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# llms.txt must stay fresh and be easy for AI crawlers to fetch
/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
